# =====================================================================
# Kavenue — environment template. Copy to .env.local and fill in real values.
#   cp .env.example .env.local
# .env.local is git-ignored. NEVER commit real keys.
# Values live in: Supabase dashboard -> Project Settings -> API / API Keys.
# =====================================================================

# Bare project URL (no /rest/v1/ suffix), e.g. https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe key: "anon" (legacy JWT) or "publishable" (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key: "service_role" (legacy JWT) or "secret" (sb_secret_...).
# BYPASSES RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. ONLY for hosted testing (e.g. Vercel): set a secret string to enable
# the one-click /dev-login on the live site, reachable at
#   /dev-login?key=<this value>
# Leave UNSET in real production — without it, hosted dev sign-in stays blocked.
DEV_LOGIN_KEY=

# Mapbox PUBLIC token (starts with pk.). Browser-visible by design.
# ⚑ ROUTING ONLY, and deliberately so (founder, 2026-08-24). lib/directions.ts uses
# driving-traffic + depart_at, which returns a traffic-predicted duration AT the
# scheduled pickup time — that duration feeds the ETA and the ±90min slot band.
# Google has no equivalent worth the swap. Do NOT move routing.
# Get it: mapbox.com -> Account -> Tokens -> Default public token.
# Restrict it to your domains in the Mapbox dashboard. Also add it to Vercel.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Google Maps PUBLIC key. Browser-visible by design — used for the address box:
# autocomplete + the coordinates of the place you pick. NOTHING else.
# ⚑ Places API (New) ONLY. Do not enable Directions or Geocoding on this key;
# routing stays on Mapbox (see above).
# Get it: console.cloud.google.com -> project "Kavenue" -> APIs & Services ->
# Credentials -> Create credentials -> API key. Billing must be linked first.
# ⚑ RESTRICT IT, it ships to the browser: Application restrictions -> Websites
# (localhost:3000/*, kavenue.fr/*, the Vercel URL) AND API restrictions ->
# Restrict key -> Places API (New) only. Also add it to Vercel.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ---------------------------------------------------------------------
# NOT an env var, but required for magic-link sign-in to work:
# In the Supabase dashboard -> Authentication -> URL Configuration, add every
# origin's /auth/callback to the Redirect URLs allowlist (and set Site URL).
# Currently configured (Site URL = https://kavenue.fr):
#   https://kavenue.fr/auth/callback
#   https://www.kavenue.fr/auth/callback
#   https://driver.kavenue.fr/auth/callback
#   https://dispatch.kavenue.fr/auth/callback
#   http://localhost:3000/auth/callback     (local dev)
# Without this, magic links redirect to the Site URL and sign-in silently fails.
# ---------------------------------------------------------------------
